# Julia
# Manifest.toml is tracked for reproducible application installs.
.julia/
*.ji
*.cov
coverage/

# Node/Playwright frontend test tooling
node_modules/
playwright-report/
test-results/

# Python helpers, if used locally
__pycache__/
*.pyc

# Env / secrets
.env
.env.*
!.env.example

# Runtime data
/data/*
!/data/.gitkeep
!/data/uploads/
!/data/uploads/.gitkeep
/tmp/
*.log

# Docker/build
.docker/

# AI Workflow System (proprietary — do not publish)
.agent/workflows/
.agent/guides/
.agent/agents/
.agent/.last-sync

# Internal project planning
docs/progress.md
docs/yolo-inbox.md
docs/build-journal.md
docs/build-journal/
docs/architect_journal.md
docs/*PRD*.md
docs/*prd*.md

# YOLO runtime generated artifacts (always ignored)
tools/klevar-yolo-runtime/node_modules/
tools/klevar-yolo-runtime/dist/
.yolo/worktrees/
.yolo/pi-sessions/
.yolo/subagent-prompts/
.yolo/subagent-runs/
.yolo/events/
.yolo/runtime-state.json

# YOLO Mode workspace — audit trail
.yolo/

# Multi-agent platform context
CLAUDE.md
AGENTS.md
.cursorrules
.claude/
.claude/settings.local.json
.claude/projects/
.claude/ide/
.claude/shell-snapshots/
.claude/todos/
.claude/statsig/

# Klevar local operational tooling — managed by /refresh and never app source
tools/klevar-yolo-runtime/
tools/klevar-pi-package/
.yolo/refresh/
.yolo/runtime/
.yolo/runtime-lock.json
.yolo/runtime-pid.json
.yolo/command-cache.json
.pi/browser/
