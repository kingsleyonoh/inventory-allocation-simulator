# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=info
GENIE_LOG_REQUESTS=true

# Database and Cache
POSTGRES_DB=inventory_allocation
POSTGRES_USER=inventory
POSTGRES_PASSWORD=your-password-here
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
DUCKDB_PATH=./data/backtests.duckdb

# Tenant Management
SELF_REGISTRATION_ENABLED=true
API_KEY_PREFIX=ias_live
DEFAULT_TENANT_NAME=Default
DEFAULT_ADMIN_EMAIL=admin@example.com
SESSION_SECRET=your-session-secret-here

# Imports
MAX_IMPORT_MB=25
IMPORT_PARTIAL_COMMIT=false
UPLOAD_STORAGE_PATH=./data/uploads

# Simulation and Solver
DEFAULT_SCENARIO_COUNT=100
MIN_HISTORY_PERIODS=8
FORECAST_LOOKBACK_DAYS=180
SOLVER_TIMEOUT_SECONDS=120
MAX_SOLVER_GAP=0.05
MIN_TRANSFER_UNITS=1
RUN_STALE_AFTER_MINUTES=30
SIMULATION_IDEMPOTENCY_WINDOW_HOURS=24
RECOMMENDATION_EXPIRY_DAYS=7
REQUIRE_REJECTION_REASON=true

# Ecosystem Integrations
NOTIFICATION_HUB_ENABLED=false
NOTIFICATION_HUB_URL=https://notify.example.test
NOTIFICATION_HUB_API_KEY=your-key-here
WORKFLOW_ENGINE_ENABLED=false
WORKFLOW_ENGINE_URL=https://workflows.example.test
WORKFLOW_ENGINE_API_KEY=your-key-here
WORKFLOW_ALLOCATION_APPROVAL_WORKFLOW_ID=00000000-0000-0000-0000-000000000000
DELIVERY_GATEWAY_ENABLED=false
DELIVERY_GATEWAY_URL=http://localhost:3000
DELIVERY_GATEWAY_API_KEY=your-key-here
DELIVERY_REDIS_URL=redis://localhost:6379/1

# Observability
SENTRY_DSN=
METRICS_TOKEN=your-token-here
POSTHOG_ENABLED=false
POSTHOG_URL=https://app.posthog.com
POSTHOG_API_KEY=
DEMO_MODE=true
